# GEMINI_API_KEY: Required for Google Gemini AI API calls (Free Tier default provider).
# AI Studio automatically injects this at runtime from user secrets.
# Configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Optional Free-Tier Alternative Providers (OpenAI-compatible endpoints):
# Configure in the AI Studio Secrets panel if you want fallback or open-source model providers.
GROQ_API_KEY=OPTIONAL_GROQ_API_KEY
OPENROUTER_API_KEY=OPTIONAL_OPENROUTER_API_KEY
